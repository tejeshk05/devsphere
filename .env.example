# ==========================================
# DevSphere Environment Configuration
# ==========================================

# 1. Private Authentication Secret
# Master access key required to log into your personal DevSphere deployment
DEVSUSPHERE_ACCESS_KEY=devsphere-master-key-2026

# Secret key used to sign secure HTTP-only session cookies
AUTH_SESSION_SECRET=change-this-to-a-random-32-char-secret-string

# Name displayed on the authorized owner badge
AUTHORIZED_ACCOUNT_NAME="D. Tejesh Kumar"

# 2. GitHub REST API Token (Server-Side Only)
# Optional, but HIGHLY recommended to increase your GitHub API rate limit
# from 60 requests/hour to 5,000 requests/hour!
# Generate one at: https://github.com/settings/tokens (Read-only / public_repo permissions)
GITHUB_TOKEN=

# 3. AI Repository Explainer Engine (Server-Side Only)
# Google Gemini API key for deep architecture analysis & summaries
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

